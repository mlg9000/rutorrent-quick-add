{
  "manifest_version": 2,
  "name": "ruTorrent Quick Add",
  "version": "1.0.8",
  "description": "Route magnet and torrent links to labeled ruTorrent destinations.",
  "permissions": [
    "storage",
    "tabs",
    "<all_urls>",
    "notifications",
    "contextMenus"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "ruTorrent Quick Add",
    "default_popup": "launcher.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rutorrent-quick-add@extensions.example",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "web_accessible_resources": [
    "page-fetch.js"
  ]
}
